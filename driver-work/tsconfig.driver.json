{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "rootDir": "src/lib/puppet",
    "outDir": "public/driver-foundation/modules"
  },
  "include": [
    "src/lib/puppet/driver/**/*.ts"
  ]
}